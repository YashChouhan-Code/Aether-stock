PORT=5000
NODE_ENV=development

# To connect to a local PostgreSQL database, use a URL like below:
# Replace "postgres", "password", and "stockforge" with your actual username, password, and database name.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/stockforge

# If you have a Render PostgreSQL database already created, put its "External Database URL" here:
# DATABASE_URL=postgresql://your_user:your_password@your_host.render.com/your_db
